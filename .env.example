# Runtime
NODE_ENV=production
PORT=5000
BASE_PATH=/
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Admin catalog access — generate a long random value; never expose it as VITE_*
APEX_ADMIN_KEY=replace-with-at-least-32-random-characters

# Used only to hash rate-limit identifiers before storing them
RATE_LIMIT_SALT=replace-with-at-least-16-random-characters

# Optional cross-origin web clients. Leave empty for same-origin-only deployments.
ALLOWED_ORIGINS=https://example.com
TRUST_PROXY_HOPS=1

# AI integration
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=replace-me

# Cost controls (per hashed client / 15 minutes)
DESIGN_RATE_LIMIT_PER_15M=30
RENDER_RATE_LIMIT_PER_15M=8
